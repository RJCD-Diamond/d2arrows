#!/bin/sh
# Lightweight xdg-open/open wrapper that prints any URLs it receives.
# Usage: copy this script to $HOME/bin/xdg-open and $HOME/bin/open and ensure it's on PATH.

printf 'xdg-open wrapper invoked\n' >&2
printf 'ARGS: %s\n' "$*" >&2
env | grep -E '^BROWSER=|^DISPLAY=|^WAYLAND_DISPLAY=|^XDG_' >&2 || true

found=0
for a in "$@"; do
  case "$a" in
    http://*|https://*)
      printf '%s\n' "$a"
      found=1
      ;;
    file://*)
      # strip scheme
      path=${a#file://}
      if [ -f "$path" ]; then
        url=$(grep -Eo "https?://[^\"')<> ]+" "$path" | head -n1 || true)
        if [ -n "$url" ]; then
          printf '%s\n' "$url"
          found=1
        else
          printf 'file://%s\n' "$path"
        fi
      else
        printf '%s\n' "$a"
      fi
      ;;
    *)
      if [ -f "$a" ]; then
        url=$(grep -Eo "https?://[^\"')<> ]+" "$a" | head -n1 || true)
        if [ -n "$url" ]; then
          printf '%s\n' "$url"
          found=1
        else
          printf 'file://%s\n' "$a"
        fi
      else
        printf '%s\n' "$a"
      fi
      ;;
  esac
done

if [ "$found" -eq 0 ]; then
  printf '\n(No explicit http(s) URL found; wrapper printed raw args.)\n' >&2
fi

exit 0
